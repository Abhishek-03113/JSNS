# Public URL of this server. The OAuth redirect URI is BASE_URL + /auth/google/callback
BASE_URL=http://localhost:3000
PORT=3000

# Google Cloud > APIs & Services > Credentials > OAuth client ID (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres. On Supabase: Project Settings > Database > Connection string (URI).
# The transaction pooler (port 6543) works; add ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/formbuilder

# 32+ random characters. Signs nothing public; encrypts Google tokens at rest. Generate: openssl rand -base64 48
SESSION_SECRET=

# Deployment ID printed by `bun run setup:executor`
APPS_SCRIPT_EXECUTOR_ID=

# Optional: comma-separated origins allowed to call /api/* with a bearer token (use * for any)
CORS_ORIGINS=
# Optional: only these Google accounts may sign in
ALLOWED_EMAILS=
# Optional: session length in days (default 30)
SESSION_DAYS=30
